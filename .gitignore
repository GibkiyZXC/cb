local function applySkybox()
local oldCustom = Lighting:FindFirstChild("Perplexity_CustomSky")
if oldCustom then oldCustom:Destroy() end

if not envSettings.SkyboxEnabled then
    local current = Lighting:FindFirstChildOfClass("Sky")
    if current then
        for prop, val in pairs(defaultSky) do
            pcall(function() current[prop] = val end)
        end
    end
    return
end

local skyData = Skyboxes[envSettings.SkyboxType]
if skyData then
    local newSky = Instance.new("Sky")
    newSky.Name = "Perplexity_CustomSky"
    newSky.SunTextureId = "rbxassetid://"
    newSky.CelestialBodiesShown = false
    for prop, val in pairs(skyData) do
        pcall(function() newSky[prop] = val end)
    end
    newSky.Parent = Lighting
end
end
