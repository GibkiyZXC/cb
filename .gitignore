local function createRow(parent, labelText)
local row = Instance.new("Frame")
row.Name = getRandomName()
row.Size = UDim2.new(1, -8, 0, 30)
row.BackgroundColor3 = THEME.PanelInner
row.BackgroundTransparency = 1
row.BorderSizePixel = 0
row.Parent = parent
corner(row, 5)

row.MouseEnter:Connect(function() tween(row, QUICK, { BackgroundTransparency = 0.55 }) end)
row.MouseLeave:Connect(function() tween(row, QUICK, { BackgroundTransparency = 1 }) end)

local label = Instance.new("TextLabel")
label.Name = getRandomName()
label.Size = UDim2.new(0.55, 0, 1, 0)
label.Position = UDim2.new(0, 10, 0, 0)
label.BackgroundTransparency = 1
label.TextSize = 13
label.TextColor3 = THEME.Text
label.TextXAlignment = Enum.TextXAlignment.Left
label.Text = labelText
label.Parent = row
setPixelFont(label)

return row
end
local function addToggle(parent, labelText, default, callback)
local row = createRow(parent, labelText)
local box = Instance.new("TextButton")
box.Name = getRandomName()
box.Size = UDim2.new(0, 16, 0, 16)
box.Position = UDim2.new(1, -26, 0.5, -8)
box.BackgroundColor3 = THEME.Field
box.Text = ""
box.AutoButtonColor = false
box.BorderSizePixel = 0
box.Parent = row
corner(box, 4)
stroke(box, THEME.Stroke, 1)

local check = Instance.new("TextLabel")
check.Name = getRandomName()
check.Size = UDim2.new(1, 0, 1, 0)
check.BackgroundTransparency = 1
check.TextSize = 13
check.TextColor3 = THEME.Accent
check.Text = "X"
check.TextTransparency = 1
check.Parent = box
setPixelFont(check)

local state = default or false
local function render(animate)
    local info = animate and QUICK or TweenInfo.new(0)
    if state then
        tween(box, info, { BackgroundColor3 = THEME.PanelInner })
        tween(check, info, { TextTransparency = 0 })
    else
        tween(box, info, { BackgroundColor3 = THEME.Field })
        tween(check, info, { TextTransparency = 1 })
    end
end
render(false)

box.MouseButton1Click:Connect(function()
    state = not state
    render(true)
    if callback then callback(state) end
end)
return row
end
local function addWideDropdown(parent, labelText, options, callback)
local labelRow = Instance.new("Frame")
labelRow.Name = getRandomName()
labelRow.Size = UDim2.new(1, -8, 0, 20)
labelRow.BackgroundTransparency = 1
labelRow.BorderSizePixel = 0
labelRow.Parent = parent

local label = Instance.new("TextLabel")
