addSlider(colAIMSettings, "Field of View", 30, 500, 100, "px", function(val) aimSettings.FOV = val end)
addToggle(colAIMSettings, "Show FOV Circle", false, function(state) aimSettings.ShowFOV = state end)
addToggle(colAIMSettings, "son", false, function(state) killSettings.Enabled = state end)
addToggle(colAIMSettings, "son", false, function(state) killSettings.Wallbang = state end)
addSlider(colAIMSettings, "son", 1, 10, 1, "", function(val) killSettings.Burst = val end)
local espPage = createTab("ESP")
local colESPMain = createColumn(espPage, "ESP Main", 18, 385)
addToggle(colESPMain, "Enable ESP", false, function(state) espSettings.Enabled = state end)
addToggle(colESPMain, "Names", false, function(state) espSettings.Names = state end)
addToggle(colESPMain, "Distance", false, function(state) espSettings.Distance = state end)
addToggle(colESPMain, "Chams", false, function(state) espSettings.Chams = state end)
addToggle(colESPMain, "Bullet Tracers", false, function(state) espSettings.Tracers = state end)
addDropdown(colESPMain, "Tracer Mode", {"Beam", "Part"}, function(val) espSettings.TracerMode = val end)
addDropdown(colESPMain, "Tracer Color", {"Accent", "Cyan", "Red", "Green", "White"}, function(val)
if val == "Accent" then espSettings.TracerColor = THEME.Accent
elseif val == "Cyan" then espSettings.TracerColor = Color3.fromRGB(0, 255, 255)
elseif val == "Red" then espSettings.TracerColor = Color3.fromRGB(255, 0, 0)
elseif val == "Green" then espSettings.TracerColor = Color3.fromRGB(0, 255, 0)
elseif val == "White" then espSettings.TracerColor = Color3.fromRGB(255, 255, 255) end
end)
local colESPFilters = createColumn(espPage, "Filters", 422, 395)
addToggle(colESPFilters, "Team check", false, function(state) espSettings.TeamCheck = state end)
addSlider(colESPFilters, "Max distance", 100, 5000, 1000, "m", function(val) espSettings.MaxDistance = val end)
addToggle(colESPFilters, "Enable Hit Sounds", false, function(state) espSettings.HitSoundEnabled = state end)
addDropdown(colESPFilters, "Hit Sound Type", {"Fatality", "Old Fatality", "Neverlose", "Skeet", "Bell"}, function(val) espSettings.HitSoundType = val end)
addSlider(colESPFilters, "Hit Sound Volume", 1, 10, 5, "", function(val) espSettings.HitSoundVolume = val end)
local skinsPage = createTab("SKINS")
local selectedKnifeModel = skinConfig.skinKnifeModel or "Karambit"
local selectedKnifeSkin = "Lore"
local weaponSettings = { Weapon = "AK47", Skin = "Stock" }
local colKnives = createColumn(skinsPage, "Knife Changer", 18, 385)
addToggle(colKnives, "Enable Knife Changer", skinConfig.skinKnifeChanger, function(state) skinConfig.skinKnifeChanger = state end)
local knifeList = {"Karambit", "Butterfly Knife", "M9 Bayonet", "Bayonet", "Huntsman Knife", "Falchion Knife", "Bowie Knife", "Shadow Daggers", "CT Knife", "T Knife"}
knifeDropdown = addWideDropdown(colKnives, "Select Knife Model", knifeList, function(val)
selectedKnifeModel = val
local newSkins = getSkinsFor(val)
if knifeSkinDropdown then
knifeSkinDropdown.UpdateOptions(newSkins)
selectedKnifeSkin = newSkins[1] or "Stock"
end
end)
local initialKnifeSkins = getSkinsFor(selectedKnifeModel)
knifeSkinDropdown = addWideDropdown(colKnives, "Select Knife Skin", initialKnifeSkins, function(val) selectedKnifeSkin = val end)
local colWeapons = createColumn(skinsPage, "Weapon Skins", 422, 395)
addToggle(colWeapons, "Enable Weapon Skins", skinConfig.skinSkinChanger, function(state) skinConfig.skinSkinChanger = state end)
local initialWeaponModel = gunList[1] or "AK47"
weaponSettings.Weapon = initialWeaponModel
weaponDropdown = addWideDropdown(colWeapons, "Select Weapon", gunList, function(val)
weaponSettings.Weapon = val
local newSkins = getSkinsFor(val)
if weaponSkinDropdown then
weaponSkinDropdown.UpdateOptions(newSkins)
weaponSettings.Skin = newSkins[1] or "Stock"
end
end)
local initialWeaponSkins = getSkinsFor(initialWeaponModel)
weaponSkinDropdown = addWideDropdown(colWeapons, "Select Skin", initialWeaponSkins, function(val) weaponSettings.Skin = val end)
local function applySkinsAction()
if skinConfig.skinKnifeChanger then
skinConfig.skinKnifeModel = selectedKnifeModel
local formattedKnife = selectedKnifeModel:gsub(" ", ""):gsub("-", "")
skinConfig["skin_knife_" .. formattedKnife] = selectedKnifeSkin
pcall(function() SwapKnifeModel(selectedKnifeModel) end)
end
if skinConfig.skinSkinChanger then
local formattedWeapon = weaponSettings.Weapon:gsub(" ", ""):gsub("-", "")
skinConfig["skin_" .. formattedWeapon] = weaponSettings.Skin
applySkin(weaponSettings.Weapon, weaponSettings.Skin)
end
task.wait(0.05)
pcall(function()
local arms = workspace.CurrentCamera:FindFirstChild("Arms")
if arms then arms:Destroy() end
end)
end
addButton(colKnives, "Apply All Skins", applySkinsAction)
addButton(colWeapons, "Apply All Skins", applySkinsAction)
local miscPage = createTab("MISC")
local colMISCMain = createColumn(miscPage, "Misc Main", 18, 385)
addToggle(colMISCMain, "Bunnyhop", false, function(state) miscSettings.BhopEnabled = state end)
addSlider(colMISCMain, "Bhop Speed Limit", 20, 120, 38, " studs/s", function(val) miscSettings.BhopSpeed = val end)
addToggle(colMISCMain, "Third Person", false, function(state) updateThirdPersonState(state) end)
addSlider(colMISCMain, "Third Person Distance", 2, 30, 8, "", function(val) miscSettings.ThirdPersonDist = val end)
local envPage = createTab("ENV")
local colWeather = createColumn(envPage, "Weather Settings", 18, 385)
addToggle(colWeather, "Enable Dynamic Weather", false, function(state) envSettings.WeatherEnabled = state; applyWeather() end)
addDropdown(colWeather, "Weather Type", {"Snow", "Light Rain", "Heavy Rain", "Ash"}, function(val) envSettings.WeatherType = val; applyWeather() end)
addSlider(colWeather, "Weather Intensity", 25, 200, 100, "%", function(val) envSettings.WeatherIntensity = val; applyWeather() end)
local colSkybox = createColumn(envPage, "Skybox Customizer", 422, 395)
addToggle(colSkybox, "Enable Custom Skybox", false, function(state) envSettings.SkyboxEnabled = state; applySkybox() end)
local skyboxOptions = {}
for skyName, _ in pairs(Skyboxes) do table.insert(skyboxOptions, skyName) end
table.sort(skyboxOptions)
addWideDropdown(colSkybox, "Select Skybox Preset", skyboxOptions, function(val) envSettings.SkyboxType = val; applySkybox() end)
initCameraHook()
getgenv().PerplexityInstance = {
Disconnect = function(self)
killSettings.Enabled = false
pcall(function() UserInputService.MouseIconEnabled = true; if customCursor then customCursor:Destroy() end end)
pcall(function() if fovCircle then fovCircle:Destroy() end end)
pcall(function() if cameraConnection then cameraConnection:Disconnect() end end)
pcall(function() gui:Destroy() end)
pcall(function() updateThirdPersonState(false) end)
pcall(function() clearWeather(); if weatherFolder then weatherFolder:Destroy() end end)
pcall(function()
local oldCustom = Lighting:FindFirstChild("Perplexity_CustomSky")
if oldCustom then oldCustom:Destroy() end
local current = Lighting:FindFirstChildOfClass("Sky")
if current and defaultSky then
for prop, val in pairs(defaultSky) do pcall(function() current[prop] = val end) end
end
end)
pcall(function()
if Viewmodels then
if Viewmodels:FindFirstChild("v_CT Knife") then Viewmodels:FindFirstChild("v_CT Knife"):Destroy() end
if Viewmodels:FindFirstChild("v_T Knife") then Viewmodels:FindFirstChild("v_T Knife"):Destroy() end
if OriginalCTKnife then OriginalCTKnife:Clone().Parent = Viewmodels end
if OriginalTKnife then OriginalTKnife:Clone().Parent = Viewmodels end
end
end)
end
}
task.spawn(function()
local events = ReplicatedStorage:WaitForChild("Events", 15)
local hitRemote = events and events:WaitForChild("HitPart", 10)
if not hitRemote then return end

RunService.Heartbeat:Connect(function()
    if not killSettings.Enabled then return end
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool or not tool:FindFirstChild("WeaponConf") then return end
    
    local gunName = tool.Name
    local gunRef = ReplicatedStorage.Weapons:FindFirstChild(gunName)
    local camPos = Workspace.CurrentCamera.CFrame.Position
    local srvTime = workspace:GetServerTimeNow()

    for _, plr in pairs(Players:GetPlayers()) do
        if plr == player then continue end
        if aimSettings.TeamCheck and plr.Team == player.Team then continue end
        local pChar = plr.Character
        if not pChar then continue end
        local head = pChar:FindFirstChild("Head") or pChar:FindFirstChild("HeadHB")
        local pHum = pChar:FindFirstChildOfClass("Humanoid")
        if head and pHum and pHum.Health > 0 then
            if not killSettings.Wallbang then
                if not isPartVisible(head, pChar) then continue end
            end
            for i = 1, killSettings.Burst do
                pcall(function()
                    local posArg = Vector3.new(0, 0, 0)
                    hitRemote:FireServer(
                        head, posArg, gunName, 4096, gunRef, nil, 1, false, true,
                        camPos, srvTime, Vector3.new(0,1,0), true, true, true, true, true
                    )
                end)
            end
        end
    end
end)
end)
selectTab("AIM")
setOpen(true)
