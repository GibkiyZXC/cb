local tabLayout = Instance.new("UIListLayout")
tabLayout.FillDirection = Enum.FillDirection.Horizontal
tabLayout.VerticalAlignment = Enum.VerticalAlignment.Center
tabLayout.Padding = UDim.new(0, 6)
tabLayout.Parent = tabBar
local pages = Instance.new("Frame")
pages.Name = getRandomName()
pages.Size = UDim2.new(1, 0, 1, -45)
pages.Position = UDim2.new(0, 0, 0, 45)
pages.BackgroundTransparency = 1
pages.ClipsDescendants = true
pages.Parent = window
local tabs = {}
local activeTab = nil
local function selectTab(name)
for tabName, data in pairs(tabs) do
local isActive = (tabName == name)
if isActive and activeTab ~= name then
data.page.Visible = true
data.page.Position = UDim2.new(0, 0, 0, 12)
tween(data.page, SMOOTH, { Position = UDim2.new(0, 0, 0, 0) })
elseif not isActive then
data.page.Visible = false
end
tween(data.button, QUICK, { TextColor3 = isActive and THEME.Text or THEME.TextDim })
local goal = isActive and UDim2.new(0.7, 0, 0, 2) or UDim2.new(0, 0, 0, 2)
tween(data.underline, QUICK, { Size = goal })
end
activeTab = name
end
local TAB_ICONS = { AIM = "[A]", ESP = "[E]", SKINS = "[S]", MISC = "[M]", ENV = "[W]" }
local function createTab(name)
local icon = TAB_ICONS[name] or "[ ]"
local button = Instance.new("TextButton")
button.Name = getRandomName()
button.Size = UDim2.new(0, 72, 0, 34)
button.BackgroundTransparency = 1
button.TextSize = 11
button.TextColor3 = THEME.TextDim
button.TextXAlignment = Enum.TextXAlignment.Center
button.Text = icon .. " " .. name:upper()
button.Parent = tabBar
setPixelFont(button)

local underline = Instance.new("Frame")
underline.Name = getRandomName()
underline.AnchorPoint = Vector2.new(0.5, 0)
underline.Position = UDim2.new(0.5, 0, 1, -4)
underline.Size = UDim2.new(0, 0, 0, 2)
underline.BackgroundColor3 = THEME.Accent
underline.BorderSizePixel = 0
underline.Parent = button
corner(underline, 2)

local page = Instance.new("CanvasGroup")
page.Name = getRandomName()
page.Size = UDim2.new(1, 0, 1, 0)
page.BackgroundTransparency = 1
page.Visible = false
page.Parent = pages

button.MouseEnter:Connect(function()
    if activeTab ~= name then tween(button, QUICK, { TextColor3 = THEME.Text }) end
end)
button.MouseLeave:Connect(function()
    if activeTab ~= name then tween(button, QUICK, { TextColor3 = THEME.TextDim }) end
end)
button.MouseButton1Click:Connect(function() selectTab(name) end)

tabs[name] = { button = button, page = page, underline = underline }
return page
end
