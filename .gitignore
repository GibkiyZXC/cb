arrow.BackgroundTransparency = 1
arrow.TextSize = 10
arrow.TextColor3 = THEME.TextDim
arrow.Text = "v"
arrow.ZIndex = 4
arrow.Parent = dd
setPixelFont(arrow)

local listFrame = Instance.new("ScrollingFrame")
listFrame.Name = getRandomName()
listFrame.Size = UDim2.new(0, 100, 0, 0)
listFrame.Position = UDim2.new(1, -110, 0.5, 13)
listFrame.BackgroundColor3 = THEME.PanelInner
listFrame.BorderSizePixel = 0
listFrame.ClipsDescendants = true
listFrame.Visible = false
listFrame.ZIndex = 10
listFrame.ScrollBarThickness = 3
listFrame.ScrollBarImageColor3 = THEME.Stroke
listFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
listFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
listFrame.Parent = row
corner(listFrame, 5)
stroke(listFrame, THEME.Stroke, 1)

local lfLayout = Instance.new("UIListLayout")
lfLayout.Name = getRandomName()
lfLayout.Parent = listFrame

local open = false
local fullHeight = #options * 24
local displayHeight = math.min(fullHeight, 150)

local function clearList()
    for _, child in ipairs(listFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
end

local function buildList(opts)
    clearList()
    fullHeight = #opts * 24
    displayHeight = math.min(fullHeight, 150)
    for _, opt in ipairs(opts) do
        local optBtn = Instance.new("TextButton")
        optBtn.Name = getRandomName()
        optBtn.Size = UDim2.new(1, 0, 0, 24)
        optBtn.BackgroundColor3 = THEME.Field
        optBtn.BackgroundTransparency = 1
        optBtn.TextSize = 12
        optBtn.TextColor3 = THEME.Text
        optBtn.Text = opt
        optBtn.ZIndex = 11
        optBtn.AutoButtonColor = false
        optBtn.Parent = listFrame
        setPixelFont(optBtn)

        optBtn.MouseEnter:Connect(function() tween(optBtn, QUICK, { BackgroundTransparency = 0 }) end)
        optBtn.MouseLeave:Connect(function() tween(optBtn, QUICK, { BackgroundTransparency = 1 }) end)
        optBtn.MouseButton1Click:Connect(function()
            dd.Text = "  " .. opt
            open = false
            tween(arrow, QUICK, { Rotation = 0 })
            tween(listFrame, QUICK, { Size = UDim2.new(0, 100, 0, 0) })
            task.delay(0.15, function()
                if not open then listFrame.Visible = false; row.ZIndex = 2 end
            end)
            if callback then callback(opt) end
        end)
    end
end

buildList(options)

dd.MouseButton1Click:Connect(function()
    open = not open
    if open then
        row.ZIndex = 100 
        listFrame.Visible = true
        tween(arrow, QUICK, { Rotation = 180 })
        tween(listFrame, QUICK, { Size = UDim2.new(0, 100, 0, displayHeight) })
    else
        tween(arrow, QUICK, { Rotation = 0 })
        tween(listFrame, QUICK, { Size = UDim2.new(0, 100, 0, 0) })
        task.delay(0.15, function()
            if not open then listFrame.Visible = false; row.ZIndex = 2 end
        end)
    end
end)

return {
    Row = row,
    UpdateOptions = function(newOpts)
        buildList(newOpts)
        dd.Text = "  " .. (newOpts[1] or "None")
        if open then tween(listFrame, QUICK, { Size = UDim2.new(0, 100, 0, displayHeight) }) end
    end,
    GetValue = function() return dd.Text:sub(3) end
}
end
local function addButton(parent, text, callback)
local row = createRow(parent, "")
local btn = Instance.new("TextButton")
btn.Name = getRandomName()
btn.Size = UDim2.new(1, -20, 0, 24)
btn.Position = UDim2.new(0, 10, 0.5, -12)
btn.BackgroundColor3 = THEME.Field
btn.TextSize = 12
btn.TextColor3 = THEME.Text
btn.Text = text
btn.BorderSizePixel = 0
btn.Parent = row
corner(btn, 5)
setPixelFont(btn)

btn.MouseEnter:Connect(function() tween(btn, QUICK, { BackgroundColor3 = THEME.FieldHover }) end)
btn.MouseLeave:Connect(function() tween(btn, QUICK, { BackgroundColor3 = THEME.Field }) end)
btn.MouseButton1Click:Connect(callback)
return row
end
local function addSlider(parent, labelText, min, max, default, suffix, callback)
local row = createRow(parent, labelText)
local track = Instance.new("Frame")
track.Name = getRandomName()
track.Size = UDim2.new(0, 100, 0, 16)
track.Position = UDim2.new(1, -110, 0.5, -8)
track.BackgroundColor3 = THEME.Field
track.BorderSizePixel = 0
track.Parent = row
corner(track, 8)

local fill = Instance.new("Frame")
fill.Name = getRandomName()
fill.BackgroundColor3 = THEME.Accent
fill.BorderSizePixel = 0
fill.Parent = track
corner(fill, 8)

local fillGrad = Instance.new("UIGradient")
fillGrad.Color = ColorSequence.new(THEME.Accent, THEME.AccentGlow)
fillGrad.Parent = fill

local valueLabel = Instance.new("TextLabel")
valueLabel.Name = getRandomName()
valueLabel.Size = UDim2.new(1, 0, 1, 0)
valueLabel.BackgroundTransparency = 1
valueLabel.TextSize = 11
valueLabel.TextColor3 = THEME.Text
valueLabel.ZIndex = 3
valueLabel.Parent = track
setPixelFont(valueLabel)

local value = default or min
local dragging = false

local function setFromX(x)
    local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
    value = math.floor(min + (max - min) * rel + 0.5)
    tween(fill, TweenInfo.new(0.08), { Size = UDim2.new(rel, 0, 1, 0) })
    valueLabel.Text = value .. (suffix or "")
    if callback then callback(value) end
end

local startRel = (value - min) / (max - min)
fill.Size = UDim2.new(startRel, 0, 1, 0)
valueLabel.Text = value .. (suffix or "")

track.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        setFromX(input.Position.X)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then setFromX(input.Position.X) end
end)
return row
end
do
local dragging, dragStart, startPos = false, nil, nil
header.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 then
dragging = true
dragStart = input.Position
startPos = window.Position
end
end)
UserInputService.InputChanged:Connect(function(input)
if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
local delta = input.Position - dragStart
window.Position = UDim2.new(
startPos.X.Scale, startPos.X.Offset + delta.X,
startPos.Y.Scale, startPos.Y.Offset + delta.Y
)
end
end)
UserInputService.InputEnded:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)
end
local isOpen = true
local function setOpen(open)
isOpen = open
if open then
window.Visible = true
window.Size = UDim2.new(0, 680, 0, 470)
window.BackgroundTransparency = 1
tween(window, SMOOTH, { Size = UDim2.new(0, 835, 0, 584), BackgroundTransparency = 0 })
pcall(function()
UserInputService.MouseBehavior = Enum.MouseBehavior.Default
UserInputService.MouseIconEnabled = false
customCursor.Visible = true
end)
else
local t = tween(window, QUICK, { Size = UDim2.new(0, 680, 0, 470), BackgroundTransparency = 1 })
t.Completed:Connect(function()
if not isOpen then window.Visible = false end
end)
pcall(function()
UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
UserInputService.MouseIconEnabled = true
customCursor.Visible = false
end)
end
end
UserInputService.InputBegan:Connect(function(input, gpe)
if gpe then return end
if input.KeyCode == Enum.KeyCode.Insert then setOpen(not isOpen) end
end)
UserInputService.InputBegan:Connect(function(input, gpe)
if gpe then return end
if input.UserInputType == Enum.UserInputType.MouseButton2 then isAiming = true end
end)
UserInputService.InputEnded:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton2 then isAiming = false end
end)
local function isPartVisible(part, character)
if not part then return false end
local camera = workspace.CurrentCamera
local rParams = RaycastParams.new()
rParams.FilterType = Enum.RaycastFilterType.Exclude
rParams.FilterDescendantsInstances = {player.Character, character}
rParams.IgnoreWater = true

local origin = camera.CFrame.Position
local direction = part.Position - origin
local result = workspace:Raycast(origin, direction, rParams)
return result == nil
end
local function getClosestPlayerToMouse()
local closestPlayer = nil
local shortestDistance = math.huge
local localChar = player.Character
if not localChar then return nil end
local localHRP = localChar:FindFirstChild("HumanoidRootPart")
if not localHRP then return nil end


local mousePos = UserInputService:GetMouseLocation()
local camera = workspace.CurrentCamera

for _, plr in ipairs(Players:GetPlayers()) do
    if plr ~= player then
        local char = plr.Character
        if char and char.Parent then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local targetName = "Head"
                if aimSettings.TargetPart == "Torso" then
                    targetName = char:FindFirstChild("Torso") and "Torso" or "UpperTorso"
                elseif aimSettings.TargetPart == "HumanoidRootPart" then
                    targetName = "HumanoidRootPart"
                end
                
                local part = char:FindFirstChild(targetName) or char:FindFirstChild("Head")
                if part then
                    if aimSettings.TeamCheck and plr.Team == player.Team then continue end
                    if aimSettings.WallCheck and not isPartVisible(part, char) then continue end

                    local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local distToMouse = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if distToMouse < shortestDistance and distToMouse <= aimSettings.FOV then
                            shortestDistance = distToMouse
                            closestPlayer = part
                        end
                    end
                end
            end
        end
    end
end
return closestPlayer
end
local function createESP(plr)
if plr == player then return end

local function setupCharacter(char)
    if not char then return end
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hrp or not hum then return end

    if espObjects[plr] then
        pcall(function() espObjects[plr].Folder:Destroy() end)
    end

    local folder = Instance.new("Folder")
    folder.Name = getRandomName()
    folder.Parent = espContainer

    local billboard = Instance.new("BillboardGui")
    billboard.Name = getRandomName()
    billboard.Adornee = hrp
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = false
    billboard.Parent = folder

    local label = Instance.new("TextLabel")
    label.Name = getRandomName()
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = THEME.Text
    label.TextSize = 12
    label.TextStrokeTransparency = 0.5
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.Parent = billboard
    setPixelFont(label)

    local highlight = Instance.new("Highlight")
    highlight.Name = getRandomName()
    highlight.Adornee = char
    highlight.FillColor = THEME.Accent
    highlight.OutlineColor = THEME.Text
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Enabled = false
    highlight.Parent = folder

    espObjects[plr] = {
        Folder = folder, Billboard = billboard, Label = label,
        Highlight = highlight, Character = char, HRP = hrp, Hum = hum
    }
end

plr.CharacterAdded:Connect(setupCharacter)
if plr.Character then task.spawn(setupCharacter, plr.Character) end
end
local function removeESP(plr)
if espObjects[plr] then
pcall(function() espObjects[plr].Folder:Destroy() end)
espObjects[plr] = nil
end
end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)
for _, plr in ipairs(Players:GetPlayers()) do createESP(plr) end
task.spawn(function()
while task.wait(0.01) do
if miscSettings.BhopEnabled and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
local char = player.Character
local hum = char and char:FindFirstChildOfClass("Humanoid")
local hrp = char and char:FindFirstChild("HumanoidRootPart")
if hum and hum.Health > 0 and hrp then
if hum.FloorMaterial ~= Enum.Material.Air then hum.Jump = true end
local moveDir = hum.MoveDirection
if moveDir.Magnitude > 0 then
local currentVel = hrp.AssemblyLinearVelocity
local targetSpeed = miscSettings.BhopSpeed or 38
local velocity2D = moveDir.Unit * targetSpeed
hrp.AssemblyLinearVelocity = Vector3.new(velocity2D.X, currentVel.Y, velocity2D.Z)
end
end
end
end
end)
local function getRaycastIgnoreList()
local ignoreList = { workspace.CurrentCamera, player.Character }
for _, child in ipairs(workspace:GetChildren()) do
if child.Name == "BulletTracer" then table.insert(ignoreList, child) end
end
local rayIgnore = workspace:FindFirstChild("Ray_Ignore")
if rayIgnore then table.insert(ignoreList, rayIgnore) end
local debris = workspace:FindFirstChild("Debris")
if debris then table.insert(ignoreList, debris) end
local map = workspace:FindFirstChild("Map")
if map then
local clips = map:FindFirstChild("Clips")
if clips then table.insert(ignoreList, clips) end
local spawnPoints = map:FindFirstChild("SpawnPoints")
if spawnPoints then table.insert(ignoreList, spawnPoints) end
end
return ignoreList
end
local function processTriggerbot()
if not triggerSettings.Enabled then return end
local localChar = player.Character
if not localChar then return end
local camera = workspace.CurrentCamera
if not camera then return end

local mousePos = UserInputService:GetMouseLocation()
local unitRay = camera:ViewportPointToRay(mousePos.X, mousePos.Y)
local rParams = RaycastParams.new()
rParams.FilterType = Enum.RaycastFilterType.Exclude
rParams.FilterDescendantsInstances = getRaycastIgnoreList()
rParams.IgnoreWater = true

local raycastResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, rParams)
if not raycastResult then return end
local targetPart = raycastResult.Instance
if not targetPart then return end

local char = nil
local current = targetPart
while current and current ~= workspace do
    if current:IsA("Model") and current:FindFirstChildOfClass("Humanoid") then
        char = current
        break
    end
    current = current.Parent
end

if char and char ~= localChar then
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health > 0 then
        local targetPlr = Players:GetPlayerFromCharacter(char)
        if targetPlr then
            if triggerSettings.TeamCheck and targetPlr.Team == player.Team then return end
            local delayTime = triggerSettings.Delay / 1000
            if triggerSettings.Randomization and delayTime > 0 then
                delayTime = delayTime + (math.random(-12, 22) / 1000)
                delayTime = math.max(0, delayTime)
            end
            if delayTime > 0 then task.wait(delayTime) end

            local reMousePos = UserInputService:GetMouseLocation()
            local reUnitRay = camera:ViewportPointToRay(mousePos.X, mousePos.Y)
            local rParamsLocal = RaycastParams.new()
            rParamsLocal.FilterType = Enum.RaycastFilterType.Exclude
            rParamsLocal.FilterDescendantsInstances = getRaycastIgnoreList()
            rParamsLocal.IgnoreWater = true

            local reRaycastResult = workspace:Raycast(reUnitRay.Origin, reUnitRay.Direction * 1000, rParamsLocal)
            if reRaycastResult then
                local reTargetPart = reRaycastResult.Instance
                local reChar = nil
                local reCurrent = reTargetPart
                while reCurrent and reCurrent ~= workspace do
                    if reCurrent:IsA("Model") and reCurrent:FindFirstChildOfClass("Humanoid") then
                        reChar = reCurrent
                        break
                    end
                    reCurrent = reCurrent.Parent
                end

                if reChar == char then
                    local clientScript = findClientScript()
                    if clientScript and typeof(getsenv) == "function" then
                        local successEnv, env = pcall(getsenv, clientScript)
                        if successEnv and env then
                            if typeof(env.firebullet) == "function" then
                                local gun = env.gun
                                if gun then pcall(env.firebullet, gun) else pcall(env.firebullet) end
                                return
                            end
                        end
                    end

                    if typeof(mouse1press) == "function" and typeof(mouse1release) == "function" then
                        mouse1press()
                        task.wait(math.random(80, 120) / 1000)
                        mouse1release()
                    elseif typeof(mouse1click) == "function" then
                        mouse1click()
                    else
                        local success, vim = pcall(function() return game:GetService("VirtualInputManager") end)
                        if success and vim then
                            vim:SendMouseButtonEvent(reMousePos.X, reMousePos.Y, 0, true, game, 1)
                            task.wait(math.random(80, 120) / 1000)
                            vim:SendMouseButtonEvent(reMousePos.X, reMousePos.Y, 0, false, game, 1)
                        end
                    end
                end
            end
        end
    end
end
end
task.spawn(function()
while task.wait(0.01) do pcall(processTriggerbot) end
end)
local allSkins = {}
local function isKnifeOrGlove(name)
local lower = name:lower()
return lower:find("knife") or lower:find("axe") or lower:find("sickle") or lower:find("cleaver") or lower:find("glove") or lower:find("wrap") or lower:find("bayonet") or lower:find("karambit")
end
local function findWeaponValue(folder, name)
local val = folder:FindFirstChild(name)
if val then return val end
local cleanName = name:lower():gsub("%s+", ""):gsub("[^%w]", "")
for _, child in ipairs(folder:GetChildren()) do
local cleanChild = child.Name:lower():gsub("%s+", ""):gsub("[^%w]", "")
if cleanChild == cleanName then return child end
end
return nil
end
local oldIndex, oldNamecall
local isUnlocked = false
local function indexHook(self, index)
if checkcaller() then return oldIndex(self, index) end

if index == "Value" and typeof(self) == "Instance" and self:IsA("ValueObject") then
    local parent = self.Parent
    if parent and parent.Parent and parent.Parent.Name == "Weapons" then
        local weaponName = parent.Name
        local statName = self.Name
        if statName == "Recoil" and recoilSettings.Enabled then
            if originalWeaponStats[weaponName] and originalWeaponStats[weaponName][statName] ~= nil then
                return originalWeaponStats[weaponName][statName]
            end
        elseif statName == "Spread" and recoilSettings.NoSpread then
            if originalWeaponStats[weaponName] and originalWeaponStats[weaponName][statName] ~= nil then
                return originalWeaponStats[weaponName][statName]
            end
        end
    end
end

return oldIndex(self, index)
end
local function namecallHook(self, ...)
local args = {...}
local method = getnamecallmethod()

if checkcaller() then return oldNamecall(self, ...) end
if method == "InvokeServer" and tostring(self) == "Hugh" then return end

if method == "FireServer" then
    if typeof(args[1]) == "number" and args[1] == player.UserId then return end

    local remoteName = tostring(self)
    if (remoteName == "HitPart" or remoteName == "Hit") and espSettings.HitSoundEnabled then
        task.spawn(function()
            local hitPart = args[1]
            if hitPart and hitPart:IsA("BasePart") then
                local character = hitPart:FindFirstAncestorOfClass("Model")
                if character and character:FindFirstChildOfClass("Humanoid") then
                    local targetPlr = Players:GetPlayerFromCharacter(character)
                    if targetPlr then
                        if targetPlr == player then return end
                        if espSettings.TeamCheck and targetPlr.Team == player.Team then return end
                    end
                    local soundId = "6534947869"
                    if espSettings.HitSoundType == "Old Fatality" then soundId = "6607142036"
                    elseif espSettings.HitSoundType == "Neverlose" then soundId = "6534948092"
                    elseif espSettings.HitSoundType == "Skeet" then soundId = "5633695679"
                    elseif espSettings.HitSoundType == "Bell" then soundId = "6534947240" end

                    local sound = Instance.new("Sound")
                    sound.SoundId = "rbxassetid://" .. soundId
                    sound.Volume = (espSettings.HitSoundVolume or 5) / 5
                    sound.Parent = workspace.CurrentCamera or player:WaitForChild("PlayerGui", 5)
                    sound:Play()
                    Debris:AddItem(sound, 2)
                end
            end
        end)
    end

    if tostring(self) == "Trail" and espSettings.Tracers then
        task.spawn(function()
            local startPos = typeof(args[1]) == "Vector3" and args[1] or (args[1] and args[1].Position)
            local endPos = typeof(args[2]) == "Vector3" and args[2] or (args[2] and args[2].Position)
            if startPos and endPos then drawLocalTracer(startPos, endPos) end
        end)
    end

    if string.len(tostring(self)) == 38 then
        if not isUnlocked then
            isUnlocked = true
            for _, v in pairs(allSkins) do
                local doSkip = false
                for _, v2 in pairs(args[1]) do
                    if v[1] == v2[1] then doSkip = true; break end
                end
                if not doSkip then table.insert(args[1], v) end
            end
        end
        return
    end

    if tostring(self) == "DataEvent" and args[1] and args[1][4] then
        local currentModel = string.split(args[1][4][1], "_")[1]
        local currentSkin = string.split(args[1][4][1], "_")[2]
        local skinFolder = player:FindFirstChild("SkinFolder")
        if skinFolder and not isKnifeOrGlove(currentModel) then
            if args[1][2] == "Both" then
                local folders = {skinFolder:FindFirstChild("CTFolder"), skinFolder:FindFirstChild("TFolder")}
                for _, folder in ipairs(folders) do
                    if folder then
                        local gunValue = findWeaponValue(folder, currentModel)
                        if gunValue then gunValue.Value = currentSkin end
                    end
                end
            else
                local folder = skinFolder:FindFirstChild(args[1][2] .. "Folder")
                if folder then
                    local gunValue = findWeaponValue(folder, currentModel)
                    if gunValue then gunValue.Value = currentSkin end
                end
            end
        end
    end
end
return oldNamecall(self, ...)
end
local successHook, err = pcall(function()
if typeof(getrawmetatable) == "function" then
local mt = getrawmetatable(game)
oldIndex = mt.__index
oldNamecall = mt.__namecall
end
if typeof(hookmetamethod) == "function" then
local hIndex = hookmetamethod(game, "__index", newcclosure(indexHook))
local hNamecall = hookmetamethod(game, "__namecall", newcclosure(namecallHook))
if hIndex then oldIndex = hIndex end
if hNamecall then oldNamecall = hNamecall end
elseif typeof(getrawmetatable) == "function" then
local mt = getrawmetatable(game)
setreadonly(mt, false)
mt.__index = newcclosure(indexHook)
mt.__namecall = newcclosure(namecallHook)
setreadonly(mt, true)
else
error("Executor does not support hookmetamethod or getrawmetatable")
end
end)
local function forceWeaponReload(gunName)
local char = player.Character
if not char then return end
local backpack = player:FindFirstChild("Backpack")
local tool = char:FindFirstChild(gunName) or (backpack and backpack:FindFirstChild(gunName))
if tool then
local currentEquipped = char:FindFirstChildOfClass("Tool")
if currentEquipped and currentEquipped.Name == gunName then
currentEquipped.Parent = backpack
task.wait(0.08)
if backpack and tool then
local hum = char:FindFirstChildOfClass("Humanoid")
if hum then hum:EquipTool(tool) end
end
end
end
end
local function applySkin(gunName, skinName)
if gunName == "" or skinName == "" then return end
local skinFolder = player:WaitForChild("SkinFolder", 5)
if not skinFolder then return end
local folders = { skinFolder:FindFirstChild("CTFolder"), skinFolder:FindFirstChild("TFolder") }
local applied = false
for _, folder in ipairs(folders) do
if folder then
local gunValue = folder:FindFirstChild(gunName)
if gunValue then gunValue.Value = skinName; applied = true end
end
end
if applied then forceWeaponReload(gunName) end
end
local Images = ReplicatedStorage:WaitForChild("Images", 5)
local gunList = {}
if Images then
for _, gun in ipairs(Images:GetChildren()) do
local name = gun.Name
if not isKnifeOrGlove(name) then table.insert(gunList, name) end
end
table.sort(gunList)
end
local function getSkinsFor(itemName)
local skins = {"Stock"}
local itemData = Images and Images:FindFirstChild(itemName)
if itemData then
for _, skin in ipairs(itemData:GetChildren()) do table.insert(skins, skin.Name) end
end
if #skins == 1 then
local fallbacks = {"Fade", "Lore", "Crimson Web", "Doppler", "Marble Fade", "Tiger Tooth", "Case Hardened", "Autotronic", "Nebula", "Asiimov", "Howl", "Vulcan", "Asimov", "Hypster"}
for _, f in ipairs(fallbacks) do table.insert(skins, f) end
end
table.sort(skins)
return skins
end
task.spawn(function()
local clientScript = nil
while not clientScript do
clientScript = findClientScript()
task.wait(0.5)
end
local env = nil
if typeof(getsenv) == "function" then
local successEnv, res = pcall(getsenv, clientScript)
if successEnv and res and res.CurrentInventory then env = res end
end
if not env and typeof(getgc) == "function" then
local gc = getgc(true) or getgc()
if gc then
for _, v in ipairs(gc) do
if typeof(v) == "table" and rawget(v, "CurrentInventory") then env = v; break end
end
end
end
if env then
local Rarities = playerGui and playerGui:FindFirstChild("Client") and playerGui.Client:FindFirstChild("Rarities")
if not Rarities and playerGui and playerGui:FindFirstChild("GUI") then
Rarities = playerGui.GUI:FindFirstChild("Rarities")
end
if Rarities then
for _, child in ipairs(Rarities:GetChildren()) do table.insert(allSkins, {child.Name}) end
else
if Images then
for _, gun in ipairs(Images:GetChildren()) do
table.insert(allSkins, {gun.Name .. "_Stock"})
-- Fixed indices iterator variable to bypass math logic crash and properly format CB names
for _, skin in ipairs(gun:GetChildren()) do
table.insert(allSkins, {gun.Name .. "" .. skin.Name})
end
end
end
end
env.CurrentInventory = allSkins
end
end)
RunService.RenderStepped:Connect(function()
local localChar = player.Character
local localHRP = localChar and localChar:FindFirstChild("HumanoidRootPart")
local camera = workspace.CurrentCamera

if isOpen then
    pcall(function()
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        UserInputService.MouseIconEnabled = false
        local mouseLoc = UserInputService:GetMouseLocation()
        customCursor.Position = UDim2.new(0, mouseLoc.X, 0, mouseLoc.Y)
        customCursor.Visible = true
    end)
else
    customCursor.Visible = false
end

if fovCircle then
    if aimSettings.Enabled and aimSettings.ShowFOV then
        local mouseLocation = UserInputService:GetMouseLocation()
        fovCircle.Position = mouseLocation
        fovCircle.Radius = aimSettings.FOV
        fovCircle.Visible = true
    else
        fovCircle.Visible = false
    end
end

if recoilSettings.Enabled or recoilSettings.NoSpread then
    pcall(function()
        local clientScript = findClientScript()
        if clientScript and typeof(getsenv) == "function" then
            local env = getsenv(clientScript)
            if env then
                if recoilSettings.Enabled then if env.recoil ~= nil then env.recoil = 0 end end
                if recoilSettings.NoSpread then
                    if env.currentspread ~= nil then env.currentspread = 0 end
                    if env.spreadmodifier ~= nil then env.spreadmodifier = 0 end
                end
            end
        end
    end)
end

if miscSettings.ThirdPerson and camera then
    local startPos = camera.CFrame.Position
    local targetOffset = -camera.CFrame.LookVector * miscSettings.ThirdPersonDist
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {localChar, camera}
    local rayResult = workspace:Raycast(startPos, targetOffset, rayParams)
    local finalDistance = miscSettings.ThirdPersonDist
    if rayResult then finalDistance = math.max(0.5, (rayResult.Position - startPos).Magnitude - 0.5) end
    camera.CFrame = camera.CFrame * CFrame.new(0, 0, finalDistance)

    local arms = camera:FindFirstChild("Arms")
    if arms then
        for _, part in ipairs(arms:GetDescendants()) do
            if part:IsA("BasePart") then part.LocalTransparencyModifier = 1 end
        end
    end
    if localChar then
        for _, part in ipairs(localChar:GetDescendants()) do
            if part:IsA("BasePart") then
                if part.Name == "Head" and finalDistance < 2.5 then part.LocalTransparencyModifier = 1 else part.LocalTransparencyModifier = 0 end
            end
        end
    end
end

if envSettings.WeatherEnabled and #weatherParts > 0 and camera then
    local preset = WEATHER_PRESETS[envSettings.WeatherType or "Snow"] or WEATHER_PRESETS["Snow"]
    for i, p in ipairs(weatherParts) do
        if p and p.Parent then
            local phase = i * 0.37
            local drift = Vector3.new(math.sin(tick() + phase) * preset.Drift, 0, math.cos(tick() * 0.8 + phase) * preset.Drift)
            p.CFrame = p.CFrame + ((Vector3.new(0, -preset.Speed, 0) + drift) * (1 / 60))
            if p.Position.Y < camera.CFrame.Position.Y - 18 or (p.Position - camera.CFrame.Position).Magnitude > 170 then
                p.CFrame = CFrame.new(randomWeatherPosition(camera))
            end
        end
    end
end

local aimActive = false
if aimSettings.Enabled then
    if aimSettings.Mode == "Always" then aimActive = true
    elseif aimSettings.Mode == "Hold Key" and isAiming then aimActive = true end
end

if aimActive and camera then
    local targetPart = getClosestPlayerToMouse()
    if targetPart then
        local targetCFrame = CFrame.new(camera.CFrame.Position, targetPart.Position)
        local smooth = math.clamp(aimSettings.Smoothness, 1, 50)
        camera.CFrame = camera.CFrame:Lerp(targetCFrame, 1 / smooth)
    end
end

for plr, esp in pairs(espObjects) do
    if not esp.Character or not esp.Character.Parent or not esp.HRP or not esp.HRP.Parent or not esp.Hum or esp.Hum.Health <= 0 then
        esp.Billboard.Enabled = false; esp.Highlight.Enabled = false; continue
    end
    if not espSettings.Enabled or not localHRP then
        esp.Billboard.Enabled = false; esp.Highlight.Enabled = false; continue
    end
    if espSettings.TeamCheck and plr.Team == player.Team then
        esp.Billboard.Enabled = false; esp.Highlight.Enabled = false; continue
    end
    local dist = (localHRP.Position - esp.HRP.Position).Magnitude
    if dist > espSettings.MaxDistance then
        esp.Billboard.Enabled = false; esp.Highlight.Enabled = false; continue
    end

    esp.Highlight.Enabled = espSettings.Chams
    if espSettings.Names or espSettings.Distance then
        esp.Billboard.Enabled = true
        local text = ""
        if espSettings.Names then text = plr.DisplayName or plr.Name end
        if espSettings.Distance then
            if text ~= "" then text = text .. " [" .. math.floor(dist) .. "m]" else text = "[" .. math.floor(dist) .. "m]" end
        end
        esp.Label.Text = text
    else
        esp.Billboard.Enabled = false
    end
end
end)
local aimPage = createTab("AIM")
local colAIMMain = createColumn(aimPage, "Aimbot Main", 18, 385)
addToggle(colAIMMain, "Enable Aimbot", false, function(state) aimSettings.Enabled = state end)
addToggle(colAIMMain, "No Recoil (Spoofed)", false, function(state) recoilSettings.Enabled = state end)
addToggle(colAIMMain, "No Spread (Spoofed)", false, function(state) recoilSettings.NoSpread = state end)
