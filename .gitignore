label.TextSize = 12
label.TextColor3 = THEME.TextDim
label.TextXAlignment = Enum.TextXAlignment.Left
label.Text = labelText
label.Parent = labelRow
setPixelFont(label)

local ddRow = Instance.new("Frame")
ddRow.Name = getRandomName()
ddRow.Size = UDim2.new(1, -8, 0, 28)
ddRow.BackgroundTransparency = 1
ddRow.BorderSizePixel = 0
ddRow.Parent = parent
ddRow.ZIndex = 2

local dd = Instance.new("TextButton")
dd.Name = getRandomName()
dd.Size = UDim2.new(1, -20, 0, 22)
dd.Position = UDim2.new(0, 10, 0.5, -11)
dd.BackgroundColor3 = THEME.Field
dd.TextSize = 12
dd.TextColor3 = THEME.Text
dd.TextXAlignment = Enum.TextXAlignment.Left
dd.Text = "  " .. (options[1] or "None")
dd.AutoButtonColor = false
dd.BorderSizePixel = 0
dd.ZIndex = 3
dd.Parent = ddRow
corner(dd, 5)
setPixelFont(dd)

local arrow = Instance.new("TextLabel")
arrow.Name = getRandomName()
arrow.Size = UDim2.new(0, 18, 1, 0)
arrow.Position = UDim2.new(1, -18, 0, 0)
arrow.BackgroundTransparency = 1
arrow.TextSize = 11
arrow.TextColor3 = THEME.TextDim
arrow.Text = "+"
arrow.ZIndex = 4
arrow.Parent = dd
setPixelFont(arrow)

local listFrame = Instance.new("ScrollingFrame")
listFrame.Name = getRandomName()
listFrame.Size = UDim2.new(1, -20, 0, 0)
listFrame.Position = UDim2.new(0, 10, 0.5, 13)
listFrame.BackgroundColor3 = THEME.PanelInner
listFrame.BorderSizePixel = 0
listFrame.ClipsDescendants = true
listFrame.Visible = false
listFrame.ZIndex = 10
listFrame.ScrollBarThickness = 3
listFrame.ScrollBarImageColor3 = THEME.Stroke
listFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
listFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
listFrame.Parent = ddRow
corner(listFrame, 5)
stroke(listFrame, THEME.Stroke, 1)

local lfLayout = Instance.new("UIListLayout")
lfLayout.Name = getRandomName()
lfLayout.Parent = listFrame

local open = false
local fullHeight = #options * 24
local displayHeight = math.min(fullHeight, 150)

local function clearList()
    for _, child in ipairs(listFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
end

local function buildList(opts)
    clearList()
    fullHeight = #opts * 24
    displayHeight = math.min(fullHeight, 150)
    for _, opt in ipairs(opts) do
        local optBtn = Instance.new("TextButton")
        optBtn.Name = getRandomName()
        optBtn.Size = UDim2.new(1, 0, 0, 24)
        optBtn.BackgroundColor3 = THEME.Field
        optBtn.BackgroundTransparency = 1
        optBtn.TextSize = 12
        optBtn.TextColor3 = THEME.Text
        optBtn.Text = opt
        optBtn.ZIndex = 11
        optBtn.AutoButtonColor = false
        optBtn.Parent = listFrame
        setPixelFont(optBtn)

        optBtn.MouseEnter:Connect(function() tween(optBtn, QUICK, { BackgroundTransparency = 0 }) end)
        optBtn.MouseLeave:Connect(function() tween(optBtn, QUICK, { BackgroundTransparency = 1 }) end)
        optBtn.MouseButton1Click:Connect(function()
            dd.Text = "  " .. opt
            open = false
            tween(listFrame, QUICK, { Size = UDim2.new(1, -20, 0, 0) })
            task.delay(0.15, function()
                if not open then listFrame.Visible = false; ddRow.ZIndex = 2 end
            end)
            if callback then callback(opt) end
        end)
    end
end

buildList(options)

dd.MouseButton1Click:Connect(function()
    open = not open
    if open then
        ddRow.ZIndex = 100 
        listFrame.Visible = true
        tween(listFrame, QUICK, { Size = UDim2.new(1, -20, 0, displayHeight) })
    else
        tween(listFrame, QUICK, { Size = UDim2.new(1, -20, 0, 0) })
        task.delay(0.15, function()
            if not open then listFrame.Visible = false; ddRow.ZIndex = 2 end
        end)
    end
end)

return {
    LabelRow = labelRow,
    DropdownRow = ddRow,
    UpdateOptions = function(newOpts)
        buildList(newOpts)
        dd.Text = "  " .. (newOpts[1] or "None")
        if open then tween(listFrame, QUICK, { Size = UDim2.new(1, -20, 0, displayHeight) }) end
    end,
    GetValue = function() return dd.Text:sub(3) end
}
end
