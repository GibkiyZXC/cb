
_G.Status = "Ready!"
local getinfo = getinfo or debug.getinfo
local DEBUG = false
local Hooked = {}
local Detected, Kill
pcall(function() setthreadidentity(2) end)
-- Primary GC collection
for i, v in pairs(getgc(true)) do
if typeof(v) == "table" then
local DetectFunc = rawget(v, "Detected")
local KillFunc = rawget(v, "Kill")

if typeof(DetectFunc) == "function" and not Detected then
        Detected = DetectFunc
        hookfunction(DetectFunc, function(Action, Info, NoCrash)
            if Action ~= "_" and DEBUG then
                warn(`[ANTICHEAT] Detected flagged: {Action}`)
            end
            return true
        end)
        table.insert(Hooked, DetectFunc)
    end

    if rawget(v, "Variables") and rawget(v, "Process") and typeof(KillFunc) == "function" and not Kill then
        Kill = KillFunc
        hookfunction(KillFunc, function(Info)
            if DEBUG then warn(`[ANTICHEAT] Kill attempt blocked: {Info}`) end
            return nil
        end)
        table.insert(Hooked, KillFunc)
    end
end
end
-- Safe debug.info hook to avoid recursion and yield crashes
local clonefunction = clonefunction or function(f) return f end
local oldDebugInfo = clonefunction(getrenv().debug.info)
hookfunction(getrenv().debug.info, newcclosure(function(...)
local levelOrFunc, info = ...
if Detected and (levelOrFunc == Detected or tostring(levelOrFunc):find("Detected")) then
-- Return spoofed data instead of yielding thread
return "=[C]", 0, "Detected", 0, false
end
return oldDebugInfo(...)
end))
-- Optimized background GC scanner
task.spawn(function()
while true do
task.wait(20) -- Increased delay to prevent memory leak
pcall(function()
local gc = getgc(true)
-- Numeric loop iteration for execution speed
for i = 1, #gc do
local v = gc[i]
if typeof(v) == "table" then
local DetectFunc = rawget(v, "Detected")
if typeof(DetectFunc) == "function" and not table.find(Hooked, DetectFunc) then
hookfunction(DetectFunc, function() return true end)
table.insert(Hooked, DetectFunc)
end
end
end
end)
end
end)
setthreadidentity(7)
_G.Status = "Adonis Bypassed!"
if getgenv().PerplexityInstance then
pcall(function() getgenv().PerplexityInstance:Disconnect() end)
end
local function getService(serviceName)
local success, service = pcall(function() return game:GetService(serviceName) end)
if success and service then
if typeof(cloneref) == "function" then
local successRef, cloned = pcall(cloneref, service)
if successRef then return cloned end
end
return service
end
return nil
end
